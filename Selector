/* ============================================================
   Jellyfin Version Selector - Final
   ============================================================ */

(function () {
  'use strict';

  const style = document.createElement('style');
  style.textContent = `
    #vselector-btn {
      background: rgba(0,164,220,0.15);
      border: 1px solid rgba(0,164,220,0.4);
      color: #00a4dc;
      border-radius: 4px;
      padding: 0 10px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: background 0.2s;
      white-space: nowrap;
      height: 36px;
      vertical-align: middle;
      margin: 0 4px;
    }
    #vselector-btn:hover { background: rgba(0,164,220,0.3); color: #fff; }
    #vselector-popup {
      position: fixed;
      bottom: 90px; right: 20px;
      width: 320px;
      background: #1e1e1e;
      border: 1px solid #444;
      border-radius: 12px;
      z-index: 999999;
      box-shadow: 0 16px 60px rgba(0,0,0,0.95);
      overflow: hidden;
      display: none;
      flex-direction: column;
    }
    #vselector-popup.vs-open { display: flex; }
    #vselector-popup .vs-header {
      padding: 12px 16px;
      background: rgba(0,164,220,0.1);
      border-bottom: 1px solid #444;
      font-size: 11px; font-weight: 800;
      letter-spacing: 1.5px; text-transform: uppercase;
      color: #00a4dc;
    }
    #vselector-popup .vs-list { max-height: 300px; overflow-y: auto; padding: 6px; }
    #vselector-popup .vs-item {
      padding: 10px 12px; border-radius: 8px; cursor: pointer;
      border: 1px solid transparent;
      display: flex; align-items: center; justify-content: space-between;
      gap: 8px; transition: background 0.15s; color: #fff;
    }
    #vselector-popup .vs-item:hover { background: rgba(255,255,255,0.07); }
    #vselector-popup .vs-item.vs-active { background: rgba(0,164,220,0.15); border-color: rgba(0,164,220,0.4); }
    #vselector-popup .vs-item-name { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
    #vselector-popup .vs-item.vs-active .vs-item-name { color: #00a4dc; }
    #vselector-popup .vs-item-meta { font-size: 10px; color: #888; }
    #vselector-popup .vs-check {
      width: 20px; height: 20px; border-radius: 50%;
      background: #00dc7d; display: flex; align-items: center;
      justify-content: center; font-size: 11px; flex-shrink: 0;
    }
    #vselector-popup .vs-check-empty {
      width: 20px; height: 20px; border-radius: 50%;
      border: 1.5px solid #555; flex-shrink: 0;
    }
    #vselector-popup .vs-footer {
      padding: 8px 16px; border-top: 1px solid #444;
      font-size: 10px; color: #666; text-align: center;
    }
    #vselector-toast {
      position: fixed; bottom: 140px; left: 50%;
      transform: translateX(-50%) translateY(10px);
      background: rgba(0,0,0,0.92);
      border: 1px solid rgba(0,220,125,0.45);
      color: #00dc7d; padding: 9px 18px; border-radius: 8px;
      font-size: 12px; font-weight: 700;
      z-index: 999999; opacity: 0; pointer-events: none;
      transition: all 0.3s ease; white-space: nowrap;
    }
    #vselector-toast.vs-show { opacity: 1; transform: translateX(-50%) translateY(0); }
  `;
  document.head.appendChild(style);

  function showToast(msg) {
    let t = document.getElementById('vselector-toast');
    if (!t) { t = document.createElement('div'); t.id = 'vselector-toast'; document.body.appendChild(t); }
    clearTimeout(t._timer);
    t.textContent = msg;
    t.classList.add('vs-show');
    t._timer = setTimeout(() => t.classList.remove('vs-show'), 2800);
  }

  function closePopup() {
    document.getElementById('vselector-popup')?.classList.remove('vs-open');
  }

  let _savedItemId = null;
  let _pendingMsId = null;
  let _pendingTicks = 0;

  function extractItemId() {
    // 1. Aus URL
    const full = window.location.hash + window.location.search;
    const m = full.match(/[?&]id=([a-f0-9]{20,})/i);
    if (m) { _savedItemId = m[1]; return m[1]; }

    // 2. Aus DOM data-id
    const el = document.querySelector('[data-id][class*="btnPlaystate"], [data-id][class*="btnUserRating"]');
    if (el) { _savedItemId = el.getAttribute('data-id'); return _savedItemId; }

    // 3. Aus video.src URL — z.B. /Videos/ITEMID/stream oder /Items/ITEMID/
    const video = document.querySelector('video');
    if (video?.src) {
      const vm = video.src.match(/\/(?:Videos|Items)\/([a-f0-9]{20,})\//i);
      if (vm) { _savedItemId = vm[1]; return vm[1]; }
    }

    // 4. Aus fetch/XHR — letzten bekannten Wert nehmen
    return _savedItemId;
  }

  // Video src beobachten um ID zu extrahieren
  const _videoObserver = new MutationObserver(() => {
    const video = document.querySelector('video');
    if (video?.src) {
      const vm = video.src.match(/\/(?:Videos|Items)\/([a-f0-9]{20,})\//i);
      if (vm) _savedItemId = vm[1];
    }
  });
  _videoObserver.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['src'] });

  // Warte bis Element im DOM erscheint
  function waitFor(selector, timeout = 6000) {
    return new Promise((resolve, reject) => {
      const el = document.querySelector(selector);
      if (el) return resolve(el);
      const ob = new MutationObserver(() => {
        const el = document.querySelector(selector);
        if (el) { ob.disconnect(); resolve(el); }
      });
      ob.observe(document.body, { childList: true, subtree: true });
      setTimeout(() => { ob.disconnect(); reject(new Error('Timeout: ' + selector)); }, timeout);
    });
  }

  // Auf Detailseite: Version setzen + Play klicken
  // BEWIESENER ABLAUF: sel.value = msId → change Event → btnPlay.click()
  async function tryAutoPlay() {
    if (!_pendingMsId) return;
    if (!window.location.hash.includes('details')) return;
    const msId = _pendingMsId;
    _pendingMsId = null;

    try {
      // Warte auf selectSource
      const sel = await waitFor('select.selectSource');
      await new Promise(r => setTimeout(r, 500));

      // Version setzen
      sel.value = msId;
      sel.dispatchEvent(new Event('change', { bubbles: true }));
      console.log('[VSF] Version gesetzt:', msId, '→', sel.options[sel.selectedIndex]?.text);

      // Warte dann Play klicken
      await new Promise(r => setTimeout(r, 400));
      const playBtn = await waitFor('button.btnPlay');
      // Position als URL-Parameter übergeben falls vorhanden
      if (_pendingTicks > 0) {
        // Jellyfin's play Button mit startPositionTicks überschreiben
        // Wir klicken den Button und fangen die Navigation ab
        const ticks = _pendingTicks;
        _pendingTicks = 0;
        // HashChange abfangen um startPositionTicks einzufügen
        const onHash = () => {
          window.removeEventListener('hashchange', onHash);
          const h = window.location.hash;
          if (h.includes('/video') && !h.includes('startPositionTicks')) {
            window.location.replace(location.href.split('#')[0] + h + '&startPositionTicks=' + ticks);
          }
        };
        window.addEventListener('hashchange', onHash);
        setTimeout(() => window.removeEventListener('hashchange', onHash), 3000);
      } else {
        _pendingTicks = 0;
      }
      playBtn.click();
      console.log('[VSF] Play geklickt ✓');
    } catch(e) {
      console.error('[VSF] Fehler:', e.message);
    }
  }

  window.addEventListener('hashchange', () => {
    extractItemId();
    setTimeout(tryAutoPlay, 200);
  });
  extractItemId();

  function getActiveMSId(mediaSources) {
    const sel = document.querySelector('select.selectSource');
    if (sel?.value) return sel.value;
    const video = document.querySelector('video');
    if (video?.src) {
      for (const src of mediaSources) {
        if (video.src.includes(src.Id)) return src.Id;
      }
    }
    return mediaSources[0]?.Id || null;
  }

  async function openVersionPopup() {
    const popup = document.getElementById('vselector-popup');
    if (popup?.classList.contains('vs-open')) { closePopup(); return; }

    const itemId = extractItemId();
    if (!itemId) { showToast('⚠ Film-ID nicht gefunden'); return; }

    let item;
    try {
      item = await ApiClient.getItem(ApiClient.getCurrentUserId(), itemId);
    } catch(e) { showToast('⚠ Fehler beim Laden'); return; }

    const mediaSources = item.MediaSources || [];
    if (mediaSources.length <= 1) { showToast('ℹ Nur eine Version verfügbar'); return; }

    const activeMSId = getActiveMSId(mediaSources);

    let p = document.getElementById('vselector-popup');
    if (!p) {
      p = document.createElement('div');
      p.id = 'vselector-popup';
      document.body.appendChild(p);
      document.addEventListener('click', (e) => {
        const btn = document.getElementById('vselector-btn');
        if (!p.contains(e.target) && (!btn || !btn.contains(e.target))) closePopup();
      });
    }

    p.innerHTML = `
      <div class="vs-header">📼 Versionen <span style="opacity:0.5;font-weight:400;letter-spacing:0">${mediaSources.length} verfügbar</span></div>
      <div class="vs-list">
        ${mediaSources.map(src => {
          const isActive = src.Id === activeMSId;
          const name = src.Name || 'Version';
          const videoStream = (src.MediaStreams || []).find(s => s.Type === 'Video');
          const height = videoStream?.Height;
          const codec = (videoStream?.VideoCodec || videoStream?.Codec || '').toUpperCase();
          const sizeGB = src.Size ? (src.Size / 1024 / 1024 / 1024).toFixed(1) + ' GB' : '';
          const meta = [height ? height+'p' : '', codec, sizeGB].filter(Boolean).join(' · ');
          return `
            <div class="vs-item ${isActive ? 'vs-active' : ''}" data-msid="${src.Id}" data-itemid="${item.Id}">
              <div style="min-width:0">
                <div class="vs-item-name">${name}</div>
                ${meta ? `<div class="vs-item-meta">${meta}</div>` : ''}
              </div>
              ${isActive ? '<div class="vs-check">✓</div>' : '<div class="vs-check-empty"></div>'}
            </div>`;
        }).join('')}
      </div>
      <div class="vs-footer">▶ Video startet beim Wechsel von Anfang</div>
    `;

    p.querySelectorAll('.vs-item').forEach(el => {
      el.addEventListener('click', () => {
        const msId = el.dataset.msid;
        const iId  = el.dataset.itemid;
        if (msId === activeMSId) { closePopup(); return; }
        closePopup();

        // Auf Detailseite: direkt wechseln
        const sel = document.querySelector('select.selectSource');
        if (sel && [...sel.options].find(o => o.value === msId)) {
          sel.value = msId;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
          setTimeout(() => document.querySelector('button.btnPlay')?.click(), 400);
          return;
        }

        // Im Player: Position speichern, zur Detailseite, dann auto-play
        const vid = document.querySelector('video');
        _pendingTicks = vid ? Math.floor(vid.currentTime * 10000000) : 0;
        _pendingMsId = msId;
        _savedItemId = iId;
        showToast('⏳ Wechsle...');
        location.replace(location.href.split('#')[0] + '#/details?id=' + iId);
      });
    });

    p.classList.add('vs-open');
  }

  function injectButton() {
    if (document.getElementById('vselector-btn')) return;
    const container = document.querySelector('.buttons.focuscontainer-x');
    if (!container) return;
    const btn = document.createElement('button');
    btn.id = 'vselector-btn';
    btn.title = 'Version wählen';
    btn.innerHTML = '📼 Version';
    btn.addEventListener('click', (e) => { e.stopPropagation(); openVersionPopup(); });
    container.insertBefore(btn, container.firstChild);
    console.log('[VSF] Button eingefügt ✓');
  }

  let lastHref = location.href;
  setInterval(() => {
    if (location.href !== lastHref) {
      lastHref = location.href;
      extractItemId();
      document.getElementById('vselector-btn')?.remove();
      setTimeout(injectButton, 500);
    }
  }, 300);

  const observer = new MutationObserver(() => injectButton());
  observer.observe(document.body, { childList: true, subtree: true });
  injectButton();
  console.log('[VSF] geladen ✓');
})();
